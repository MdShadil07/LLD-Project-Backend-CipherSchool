OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EVALUATOR_VERSION=openai-v1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EVALUATOR_VERSION=gemini-v1
